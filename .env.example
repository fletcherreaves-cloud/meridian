# Meridian — environment variables
# Copy this to .env.local (gitignored) and fill in your values.
# For GitHub Pages CI: add these as repository secrets (Settings → Secrets → Actions).

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=eyJ...

# Leave both blank to run in local-only mode (localStorage only, no auth, no sync)

# Web Push (dispatch #216) — VAPID public key, safe to expose client-side (that's what "public"
# means here). The matching VAPID_PRIVATE_KEY is server-only (GitHub Actions secret, never here).
VITE_VAPID_PUBLIC_KEY=
